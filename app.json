{
  "expo": {
    "name": "ArberPortofolio",
    "slug": "ArberPortofolio",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D0C"
      },
      "package": "com.arberh.ArberPortofolio"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "baseUrl": "/mobile-portfolio"
    },
    "extra": {
      "eas": {
        "projectId": "19f7580b-c0e5-44e3-a264-8bb2b365cae8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/19f7580b-c0e5-44e3-a264-8bb2b365cae8"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0D0C"
        }
      ],
      "expo-image"
    ],
    "scheme": "arberportfolio"
  }
}
