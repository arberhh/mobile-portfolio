{
  "name": "arberportfolio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "lint": "oxlint --deny-warnings . && eslint . --max-warnings=0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "deadcode": "knip",
    "test": "jest",
    "prepare": "git config core.hooksPath .githooks",
    "predeploy": "npm run snapshot && expo export --platform web && node scripts/postexport-web.mjs",
    "deploy": "gh-pages --nojekyll -d dist",
    "snapshot": "node scripts/snapshot-content.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-modules-core": "~57.0.17",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~58.0.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "^5.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-expo": "^1.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "gh-pages": "^6.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^6.32.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "decode-uri-component": "0.5.0",
    "postcss": "8.5.26",
    "smol-toml": "1.9.0",
    "uuid": "11.1.1"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
